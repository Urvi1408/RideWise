{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build RideWise",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-std=c++17",
                "main.cpp",
                "RideWiseSystem.cpp",
                "managers/PassengerManager.cpp",
                "managers/DriverManager.cpp",
                "managers/CabManager.cpp",
                "managers/RideManager.cpp",
                "classes/Passenger.cpp",
                "classes/Driver.cpp",
                "classes/Cab.cpp",
                "classes/Ride.cpp",
                "classes/Location.cpp",
                "algorithms/Graph.cpp",
                "algorithms/Dijkstra.cpp",
                "algorithms/FareCalculator.cpp",
                "algorithms/Matching.cpp",
                "-I",
                "C:/msys64/ucrt64/include",
                "-L",
                "C:/msys64/ucrt64/lib",
                "-lgdal",
                "-o",
                "${workspaceFolder}/RideWise.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
