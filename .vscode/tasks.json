
{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build RideWise",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-std=c++17",
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/main.cpp",
                "${workspaceFolder}/classes/Passenger.cpp",
                "${workspaceFolder}/classes/Driver.cpp",
                "${workspaceFolder}/classes/Cab.cpp",
                "${workspaceFolder}/classes/Ride.cpp",
                "${workspaceFolder}/classes/RideRequest.cpp",
                "-o",
                "${workspaceFolder}/RideWise.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
